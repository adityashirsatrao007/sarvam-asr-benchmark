# Sarvam AI platform key — https://api.sarvam.ai (Platform → API keys)
# Copy this file to `.env` and fill it in. `.env` is gitignored.
SARVAM_API_KEY=

# Optional overrides (defaults; endpoint + model live-verified 2026-10-03)
SARVAM_API_BASE=https://api.sarvam.ai
SARVAM_ASR_PATH=/speech-to-text
SARVAM_ASR_MODEL=saaras:v3
